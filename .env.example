# Copy this file to .env.local for local Docker Compose use.
# Never commit real credentials. Generate unique values for every environment.
DB_NAME=e_wallet
DB_USERNAME=replace-with-a-dedicated-database-user
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
# Generate each value independently with: openssl rand -base64 32
INVENTORY_ACTIVE_KEY_VERSION=1
INVENTORY_KEYRING=1:replace-with-a-base64-encoded-32-byte-key
INVENTORY_CHECKSUM_KEY=replace-with-another-base64-encoded-32-byte-key

# MoMo is disabled until every sandbox value below is configured.
MOMO_ENABLED=false
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=replace-with-momo-sandbox-partner-code
MOMO_ACCESS_KEY=replace-with-momo-sandbox-access-key
MOMO_SECRET_KEY=replace-with-momo-sandbox-secret-key
MOMO_REDIRECT_URL=https://replace-with-your-public-host/top-up
MOMO_IPN_URL=https://replace-with-your-public-host/api/v1/webhooks/momo

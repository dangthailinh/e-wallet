{
	# Caddy obtains and renews the certificate for PUBLIC_DOMAIN through ACME.
	# For a disposable local/staging domain, Caddy uses its local CA instead.
	auto_https prefer_wildcard
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Keep browser-facing security policy at the single public boundary.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Reject unexpectedly large requests before they reach Spring/Next. The
	# payment webhook and JSON APIs are intentionally much smaller than this.
	request_body {
		max_size 2MB
	}

	@api path /api/*
	handle @api {
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	# Everything else is the Next.js storefront. Backend and PostgreSQL are
	# reachable only on the private Compose network.
	handle {
		reverse_proxy frontend:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}
}
